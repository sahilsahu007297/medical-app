# Supabase project settings > API. Public browser credentials only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy anon keys also work via VITE_SUPABASE_ANON_KEY.
# Never put a service_role / secret key or Google client secret in a VITE_ variable.
